{
    "name": "copilot",
    "display": "GitHub Copilot",
    "renders": [
        {
            "kind": "single",
            "source": "copilot-instructions.template.md",
            "target": ".github/copilot-instructions.md"
        },
        {
            "kind": "directory",
            "source_dir": "instructions",
            "target_dir": ".github/instructions",
            "source_glob": "*.instructions.template.md",
            "target_glob": "*.instructions.md",
            "selectable": false,
            "orphan_check": true,
            "orphan_check_only_when_all": false
        },
        {
            "kind": "directory",
            "source_dir": "custom-agents",
            "target_dir": ".github/agents",
            "source_glob": "*.agent.template.md",
            "target_glob": "*.agent.md",
            "selectable": true,
            "default_select": ["all"],
            "orphan_check": true,
            "orphan_check_only_when_all": true
        },
        {
            "kind": "directory",
            "source_dir": "prompts",
            "target_dir": ".github/prompts",
            "source_glob": "*.prompt.md",
            "target_glob": "*.prompt.md",
            "selectable": false,
            "orphan_check": true,
            "orphan_check_only_when_all": false
        },
        {
            "kind": "tree",
            "source_dir": "../../_skills",
            "target_dir": ".github/skills",
            "orphan_check": true
        },
        {
            "kind": "directory",
            "source_dir": "../../../templates",
            "target_dir": ".github/templates",
            "source_glob": "*.md",
            "target_glob": "*.md",
            "selectable": false,
            "orphan_check": true,
            "orphan_check_only_when_all": false
        },
        {
            "kind": "directory",
            "source_dir": "../../../templates/instructions-examples",
            "target_dir": ".github/templates/instructions-examples",
            "source_glob": "*.example.md",
            "target_glob": "*.example.md",
            "selectable": false,
            "orphan_check": true,
            "orphan_check_only_when_all": false
        },
        {
            "kind": "single",
            "source": "handbook.md",
            "target": "{{VENDOR_DIR}}/HANDBOOK.md"
        },
        {
            "kind": "single",
            "source": "vendor-readme.template.md",
            "target": "{{VENDOR_DIR}}/README.md"
        },
        {
            "kind": "single",
            "source": "../../../docs/concepts.md",
            "target": "{{VENDOR_DIR}}/docs/concepts.md"
        },
        {
            "kind": "single",
            "source": "../../../docs/ai-usage.md",
            "target": "{{VENDOR_DIR}}/docs/ai-usage.md"
        },
        {
            "kind": "directory",
            "source_dir": "../../../docs/stages",
            "target_dir": "{{VENDOR_DIR}}/docs/stages",
            "source_glob": "*.md",
            "target_glob": "*.md",
            "selectable": false,
            "orphan_check": true,
            "orphan_check_only_when_all": false
        },
        {
            "kind": "single",
            "source": "../../../docs/repo-layout.md",
            "target": "{{VENDOR_DIR}}/docs/repo-layout.md"
        },
        {
            "kind": "single",
            "source": "../../../docs/instructions-layout.md",
            "target": "{{VENDOR_DIR}}/docs/instructions-layout.md"
        },
        {
            "kind": "single",
            "source": "../../../docs/tech-debt-gc.md",
            "target": "{{VENDOR_DIR}}/docs/tech-debt-gc.md"
        },
        {
            "kind": "single",
            "source": "../../../uninstall.ps1",
            "target": "{{VENDOR_DIR}}/uninstall.ps1"
        }
    ]
}
